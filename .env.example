APP_NAME="Hello Test PoC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://hello-test.localhost:8443

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dedicated, throw-away MySQL for this PoC only. Start it with:
#   docker compose up -d
# NEVER point these at the production database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=hello_test
DB_USERNAME=hello_test
DB_PASSWORD=
DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=hello_test

# Generate with: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
PASSKEYS_USER_HANDLE_SECRET=

# ---------------------------------------------------------------------------
# Passwordless enrollment
# ---------------------------------------------------------------------------
# Aplikasi ini passwordless: karyawan masuk dengan sidik jari dan tidak pernah
# menerima password. Form username/password di /login hanya jalur pemulihan.
# Setel true bila admin perlu masuk untuk mendaftarkan sidik jari karyawan pada
# perangkat yang tidak mendukung passkey (mis. pengujian http://127.0.0.1).
AUTH_ENABLE_PASSWORD_LOGIN=false

# Bootstrap admin pertama (/bootstrap) hanya berfungsi selama belum ada user
# sama sekali. Di luar environment `local`, rute itu mensyaratkan ?key= yang
# cocok. KOSONGKAN = gagal-tertutup (bootstrap nonaktif di server nyata).
BOOTSTRAP_KEY=

# Khusus pengembangan lokal: bila true DAN APP_ENV=local, sesi yang sudah
# terautentikasi boleh mengubah passkey tanpa konfirmasi ulang. Perlu karena
# Windows Hello tidak bisa berjalan pada origin http (bukan secure context).
# Tidak berpengaruh di staging/produksi. Setel false untuk menutupnya juga.
PASSKEY_BOOTSTRAP_NO_CONFIRM=true

# Only read by the seeder. Leave blank for the seeder to generate a random one
# locally, or set a strong value (>= 12 chars) for staging. Never a weak default.
TEST_ADMIN_PASSWORD=
TEST_SUPERVISOR_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@hello-test.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
