# Production environment template — login.heloklin.com
#
# Copy to `.env` on the server and fill in the secrets. Never commit `.env`.
# Account passwords are only read by database/seeders/RolesAndUsersSeeder.php
# and must be at least 12 characters; the seeder refuses to run without them
# outside APP_ENV=local/testing.

APP_NAME="Heloklin Login"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://login.heloklin.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Dedicated database — never the dashboard/production database.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=login_heloklin
DB_USERNAME=login_heloklin
DB_PASSWORD=

# Host-only session cookie: other apps on *.heloklin.com must not share it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_HTTP_ONLY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Nothing in this app dispatches queued jobs; keep requests synchronous.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=login_heloklin

# Generate with: php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Rotating this value invalidates every registered passkey.
PASSKEYS_USER_HANDLE_SECRET=

# Test accounts (>= 12 chars each).
TEST_ADMIN_PASSWORD=
TEST_SUPERVISOR_PASSWORD=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@heloklin.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
